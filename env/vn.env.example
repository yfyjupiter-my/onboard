# T7.3: Vietnam instance (served at https://<domain>/vn/). Copy to env/vn.env and fill in.
# Same shape for env/th.env (th, Asia/Bangkok) and env/id.env (id, Asia/Jakarta).
# Secrets here are this country's ONLY credentials — never the root Postgres/MinIO ones.
DJANGO_URL_PREFIX=vn
DJANGO_LANGUAGE_CODE=vi
DJANGO_TIME_ZONE=Asia/Ho_Chi_Minh

# Own key per country: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_HTTPS=True
# Same domain as Malaysia's .env
DJANGO_ALLOWED_HOSTS=onboard.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://onboard.example.com

# Database + role created by the README "Add a country" step; the role can connect only to this DB.
DATABASE_URL=postgres://onboard_vn:change-me@db:5432/onboard_vn

# Bucket + service account (policy: this bucket only) from the same README step.
MINIO_BUCKET=onboard-vn
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# Public origin the browser uses — same as Malaysia's MINIO_PUBLIC_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=https://onboard.example.com
