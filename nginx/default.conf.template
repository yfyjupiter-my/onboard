# SEC-017: keep https from a TLS proxy/tunnel in front (else Django's SSL redirect loops);
# otherwise use our own scheme. A direct :8080 client can only claim https for itself.
map $http_x_forwarded_proto $fwd_proto {
    default $scheme;
    https   https;
}

upstream web {
    server web:8000;
}

server {
    listen 80;
    server_name _;
    server_tokens off;   # SEC-018: no nginx version in Server header / error pages
    client_max_body_size 512m;   # allow PDF/MP4 admin uploads

    # P2/P8: /media/<key> is rewritten to /<bucket>/<key> and proxied to MinIO.
    # Presigns are signed over the bucket path + public Host. Use $http_host (the
    # full Host header, port included) not $host (port stripped) — the presign
    # signs the public host WITH its port, so the forwarded Host must match or
    # MinIO returns SignatureDoesNotMatch. MinIO never exposed.
    # Bucket segment is templated from MINIO_BUCKET via the nginx image's
    # envsubst (/etc/nginx/templates/*.template) — no drift with the app.
    location /media/ {
        rewrite ^/media/(.*)$ /${MINIO_BUCKET}/$1 break;
        proxy_pass http://minio:9000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # SEC-010: media is served from the app's own origin — don't let the browser
        # sniff an upload into text/html and run it as us.
        add_header X-Content-Type-Options nosniff always;
    }

    # whitenoise serves /static/ from within gunicorn; just pass through.
    location / {
        proxy_pass http://web;
        proxy_read_timeout 120s;   # RUN-005: match gunicorn --timeout 120
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
    }
}
