upstream web {
    server web:8000;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 512m;   # allow PDF/MP4 admin uploads

    # P2/P8: /media/<key> is rewritten to /<bucket>/<key> and proxied to MinIO.
    # Presigns are signed over the bucket path + public Host, so forwarding the
    # original Host ($host) makes the signature verify here. MinIO never exposed.
    # Bucket segment is templated from MINIO_BUCKET via the nginx image's
    # envsubst (/etc/nginx/templates/*.template) — no drift with the app.
    location /media/ {
        rewrite ^/media/(.*)$ /${MINIO_BUCKET}/$1 break;
        proxy_pass http://minio:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # whitenoise serves /static/ from within gunicorn; just pass through.
    location / {
        proxy_pass http://web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
