POSTGRES_DB=onboard
POSTGRES_USER=onboard
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=onboard-media
# Public base URL the browser hits (scheme+host). Presigned GETs are signed against this.
MINIO_PUBLIC_ENDPOINT=http://localhost

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# False only for a plain-http LAN pilot: turns off Secure cookies, SSL redirect and HSTS (SEC-035).
DJANGO_HTTPS=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
